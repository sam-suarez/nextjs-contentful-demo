+import "server-only";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import mockData from "@/data/products.mock.json";
+import { productCollectionSchema, type ProductEntry, type Visibility } from "@/schemas/product";
+
