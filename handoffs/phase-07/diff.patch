+            <Line text="text-base" className="w-1/3 sm:hidden" />
+          </div>
+
+          <div aria-hidden="true" className={DETAIL_PRICE_CARD}>
+            <PriceSkeleton />
+            <div aria-hidden="true" className={`${DETAIL_PRICE_FOOTER} ${DETAIL_PRICE_FOOTER_STACK}`}>
