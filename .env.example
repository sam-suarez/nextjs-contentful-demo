# Contentful Content Delivery API (read-only, published content). Server-only: never prefix with NEXT_PUBLIC_.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=

# Session signing key (jose HS256). Server-only and required: never prefix with NEXT_PUBLIC_.
# Must be at least 32 characters; session functions throw if it is missing or shorter.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
